; Realm Wars 3D Godot 4 project
; MIT-compatible engine; no activation required.
config_version=5

[application]
config/name="Realm Wars 3D"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.47, 0.78, 0.90, 1)

[input]
select={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":1)]}
move_command={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":2)]}
